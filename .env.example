# Database Connection Settings (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=shop_db
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30

# Dialect Configuration
DEFAULT_DIALECT=mysql

# Application & Logging
LOG_LEVEL=INFO
MAX_QUERY_LENGTH=20000

# Benchmark Settings
BENCHMARK_RUNS=5
BENCHMARK_WARMUP=1
BENCHMARK_TIMEOUT_SECONDS=30

# Optional LLM / AI Configuration (Prompt 19)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
